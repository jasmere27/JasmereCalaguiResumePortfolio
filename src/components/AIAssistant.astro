---
import { SUGGESTED_QUESTIONS } from '../lib/assistant';
---

<div class="assistant-root">
  <div class="buddy-wrap">
    <button
      id="assistant-toggle"
      class="assistant-buddy"
      type="button"
      aria-haspopup="dialog"
      aria-expanded="false"
      aria-controls="assistant-panel"
      aria-label="Ask about me — open the portfolio assistant"
      data-cursor
      data-cursor-text="Ask me"
    >
      <span class="buddy-inner">
        <span class="buddy-orbit" aria-hidden="true"></span>
        <span class="buddy-face" aria-hidden="true">
          <span class="buddy-eye" data-eye="left"></span>
          <span class="buddy-eye" data-eye="right"></span>
        </span>
        <span class="buddy-status" aria-hidden="true"></span>
      </span>
    </button>
    <span id="buddy-tooltip" class="buddy-tooltip" role="tooltip">Ask about me</span>
  </div>

  <div id="assistant-panel" class="assistant-panel" role="dialog" aria-label="Portfolio assistant" hidden>
    <header class="assistant-head">
      <div class="assistant-head-identity">
        <span class="buddy-avatar" id="buddy-avatar" aria-hidden="true">
          <span class="buddy-face buddy-face-mini">
            <span class="buddy-eye"></span>
            <span class="buddy-eye"></span>
          </span>
        </span>
        <div>
          <p class="assistant-name">Portfolio Assistant</p>
          <p class="assistant-meta mono-tag">Answers grounded in the resume</p>
        </div>
      </div>
      <button id="assistant-close" type="button" class="assistant-close" aria-label="Close chat" data-cursor>
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
        </svg>
      </button>
    </header>

    <div id="assistant-log" class="assistant-log" aria-live="polite" aria-atomic="false"></div>

    <div id="assistant-chips" class="assistant-chips" role="group" aria-label="Suggested questions"></div>

    <form id="assistant-form" class="assistant-form">
      <input
        id="assistant-input"
        class="assistant-input"
        type="text"
        placeholder="Ask a question…"
        maxlength="300"
        autocomplete="off"
        aria-label="Your question"
      />
      <button type="submit" class="assistant-send" aria-label="Send message" data-cursor>
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path
            d="M4 12h15M13 6l6 6-6 6"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </button>
    </form>
  </div>
</div>

<script type="application/json" id="assistant-suggestions-data" is:inline set:html={JSON.stringify(SUGGESTED_QUESTIONS)} />

<script>
  import { gsap } from 'gsap';
  import { localAnswer, type ChatMessage } from '../lib/assistant';

  // Buddy personality: idle float is pure CSS (see below). Eye-tracking and
  // blinking are small, purely decorative touches — skipped entirely under
  // reduced motion or on touch/coarse-pointer devices.
  {
    const buddy = document.getElementById('assistant-toggle');
    const eyes = Array.from(document.querySelectorAll<HTMLElement>('.assistant-buddy .buddy-eye'));
    const tooltip = document.getElementById('buddy-tooltip');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const canHover = window.matchMedia('(hover: hover) and (pointer: fine)').matches;

    if (buddy && eyes.length && !reducedMotion) {
      if (canHover) {
        const MAX_OFFSET = 2.5;
        const eyeMovers = eyes.map((eye) => ({
          x: gsap.quickTo(eye, 'x', { duration: 0.3, ease: 'power3.out' }),
          y: gsap.quickTo(eye, 'y', { duration: 0.3, ease: 'power3.out' }),
        }));

        window.addEventListener('pointermove', (e) => {
          const rect = buddy.getBoundingClientRect();
          const cx = rect.left + rect.width / 2;
          const cy = rect.top + rect.height / 2;
          const dx = e.clientX - cx;
          const dy = e.clientY - cy;
          const dist = Math.hypot(dx, dy) || 1;
          const clamped = Math.min(dist, 220) / 220;
          const ox = (dx / dist) * MAX_OFFSET * clamped;
          const oy = (dy / dist) * MAX_OFFSET * clamped;
          eyeMovers.forEach((m) => {
            m.x(ox);
            m.y(oy);
          });
        });
      }

      // Occasional blink, timed randomly so it reads as alive rather than
      // mechanical.
      const blink = () => {
        gsap.to(eyes, { scaleY: 0.15, duration: 0.06, yoyo: true, repeat: 1, ease: 'power1.inOut' });
        window.setTimeout(blink, 2600 + Math.random() * 3200);
      };
      window.setTimeout(blink, 1800 + Math.random() * 2000);
    }

    // Invite interaction once, shortly after load, without being pushy.
    if (tooltip && !reducedMotion) {
      window.setTimeout(() => {
        if (buddy?.getAttribute('aria-expanded') === 'true') return;
        tooltip.classList.add('is-peeking');
        window.setTimeout(() => tooltip.classList.remove('is-peeking'), 2800);
      }, 2600);
    }
  }

  const toggle = document.getElementById('assistant-toggle') as HTMLButtonElement | null;
  const closeBtn = document.getElementById('assistant-close');
  const panel = document.getElementById('assistant-panel');
  const log = document.getElementById('assistant-log');
  const chipsEl = document.getElementById('assistant-chips');
  const form = document.getElementById('assistant-form') as HTMLFormElement | null;
  const input = document.getElementById('assistant-input') as HTMLInputElement | null;
  const dataEl = document.getElementById('assistant-suggestions-data');

  if (toggle && closeBtn && panel && log && chipsEl && form && input) {
    const allSuggestions: string[] = dataEl ? JSON.parse(dataEl.textContent || '[]') : [];
    const askedSuggestions = new Set<string>();
    const history: ChatMessage[] = [];
    let started = false;
    let lastFocused: HTMLElement | null = null;

    function renderChips() {
      if (!chipsEl) return;
      const remaining = allSuggestions.filter((q) => !askedSuggestions.has(q));
      chipsEl.innerHTML = '';
      chipsEl.hidden = remaining.length === 0;
      remaining.forEach((q) => {
        const chip = document.createElement('button');
        chip.type = 'button';
        chip.className = 'assistant-chip';
        chip.textContent = q;
        chip.addEventListener('click', () => send(q));
        chipsEl.appendChild(chip);
      });
    }

    function scrollToBottom() {
      if (log) log.scrollTop = log.scrollHeight;
    }

    function appendMessage(role: 'user' | 'assistant', text: string) {
      if (!log) return;
      const bubble = document.createElement('div');
      bubble.className = role === 'user' ? 'assistant-msg assistant-msg-user' : 'assistant-msg assistant-msg-bot';
      bubble.textContent = text;
      log.appendChild(bubble);
      scrollToBottom();
    }

    function setTyping(show: boolean) {
      document.getElementById('buddy-avatar')?.classList.toggle('is-thinking', show);
      if (!log) return;
      const existing = document.getElementById('assistant-typing');
      if (show && !existing) {
        const el = document.createElement('div');
        el.id = 'assistant-typing';
        el.className = 'assistant-msg assistant-msg-bot assistant-typing';
        el.innerHTML = '<span></span><span></span><span></span>';
        el.setAttribute('aria-label', 'Assistant is typing');
        log.appendChild(el);
        scrollToBottom();
      } else if (!show && existing) {
        existing.remove();
      }
    }

    async function send(question: string) {
      const trimmed = question.trim();
      if (!trimmed) return;

      if (askedSuggestions.has(trimmed)) {
        askedSuggestions.add(trimmed);
      } else {
        allSuggestions.forEach((s) => {
          if (s === trimmed) askedSuggestions.add(s);
        });
      }
      renderChips();

      appendMessage('user', trimmed);
      history.push({ role: 'user', content: trimmed });
      input!.value = '';
      input!.disabled = true;
      setTyping(true);

      let reply: string;
      try {
        const res = await fetch('/api/chat', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ message: trimmed, history: history.slice(-8) }),
        });
        if (!res.ok) throw new Error(`status ${res.status}`);
        const data = (await res.json()) as { reply?: string };
        reply = data.reply || localAnswer(trimmed);
      } catch {
        // Endpoint unavailable (e.g. local dev without wrangler, or a
        // transient network issue) — fall back to the same resume-grounded
        // engine running entirely client-side, so the assistant still works.
        reply = localAnswer(trimmed);
      }

      setTyping(false);
      appendMessage('assistant', reply);
      history.push({ role: 'assistant', content: reply });
      input!.disabled = false;
      input!.focus();
    }

    function ensureStarted() {
      if (started) return;
      started = true;
      appendMessage(
        'assistant',
        "Hi! I'm a small assistant trained only on Jasmere's resume and portfolio — ask about his experience, projects, skills, or education."
      );
      renderChips();
    }

    function openPanel() {
      lastFocused = document.activeElement as HTMLElement;
      panel!.hidden = false;
      requestAnimationFrame(() => panel!.classList.add('is-open'));
      toggle!.setAttribute('aria-expanded', 'true');
      ensureStarted();
      document.addEventListener('keydown', onKeydown);
      window.setTimeout(() => input!.focus(), 250);
    }

    function closePanel() {
      panel!.classList.remove('is-open');
      toggle!.setAttribute('aria-expanded', 'false');
      document.removeEventListener('keydown', onKeydown);
      window.setTimeout(() => {
        if (!panel!.classList.contains('is-open')) panel!.hidden = true;
      }, 300);
      lastFocused?.focus();
    }

    function onKeydown(e: KeyboardEvent) {
      if (e.key === 'Escape') closePanel();
    }

    toggle.addEventListener('click', () => {
      const isOpen = toggle.getAttribute('aria-expanded') === 'true';
      if (isOpen) closePanel();
      else openPanel();
    });

    closeBtn.addEventListener('click', closePanel);

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      send(input.value);
    });
  }
</script>

<style>
  .assistant-root {
    position: fixed;
    right: 1.25rem;
    bottom: 1.25rem;
    z-index: 80;
  }

  .buddy-wrap {
    /* display:flex (block-level), not inline-flex — the mobile layout
       relies on margin-left:auto to push this to the right edge, which
       only works reliably on a block-level box. */
    position: relative;
    display: flex;
    width: fit-content;
  }

  .assistant-buddy {
    /* The hitbox itself never moves — Playwright's click-stability check
       (correctly) flags a target that's always in motion, and a real
       cursor hovering near the edge would flicker in and out too. The
       character bobs visually via .buddy-inner instead, one layer down. */
    position: relative;
    width: 3.75rem;
    height: 3.75rem;
    border-radius: 999px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .assistant-buddy:hover,
  .assistant-buddy:focus-visible {
    transform: scale(1.04);
  }

  .buddy-inner {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: 999px;
    background: radial-gradient(circle at 34% 28%, #f5c47e, var(--color-accent) 55%, var(--color-accent-dim) 100%);
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.4), inset 0 0 0 1px rgba(255, 255, 255, 0.12);
    display: flex;
    align-items: center;
    justify-content: center;
    animation: buddy-float 4.5s ease-in-out infinite;
    transition: box-shadow 0.3s ease;
  }

  .assistant-buddy:hover .buddy-inner,
  .assistant-buddy:focus-visible .buddy-inner {
    box-shadow: 0 18px 36px rgba(0, 0, 0, 0.45), inset 0 0 0 1px rgba(255, 255, 255, 0.16);
  }

  .assistant-buddy[aria-expanded='true'] .buddy-inner {
    box-shadow: 0 0 0 3px var(--color-accent-soft), 0 12px 28px rgba(0, 0, 0, 0.4);
  }

  @keyframes buddy-float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-7px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .buddy-inner {
      animation: none;
    }
  }

  .buddy-orbit {
    position: absolute;
    inset: -9px;
    border-radius: 999px;
    border: 1px dashed var(--color-accent);
    opacity: 0.4;
    animation: buddy-spin 14s linear infinite;
  }

  @keyframes buddy-spin {
    to {
      rotate: 360deg;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .buddy-orbit {
      animation: none;
    }
  }

  .buddy-face {
    position: relative;
    width: 20px;
    height: 10px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .buddy-eye {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: var(--color-ink);
    transform-origin: center;
  }

  .buddy-status {
    position: absolute;
    right: 1px;
    bottom: 1px;
    width: 11px;
    height: 11px;
    border-radius: 999px;
    background: var(--color-signal);
    border: 2px solid var(--color-ink);
    animation: buddy-status-pulse 2.4s ease-in-out infinite;
  }

  @keyframes buddy-status-pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.45;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .buddy-status {
      animation: none;
    }
  }

  .buddy-tooltip {
    position: absolute;
    right: 0;
    bottom: calc(100% + 0.65rem);
    padding: 0.4rem 0.75rem;
    background: var(--color-surface-raised);
    border: 1px solid var(--color-border-strong);
    border-radius: 0.5rem;
    font-size: 0.78rem;
    color: var(--color-text);
    white-space: nowrap;
    opacity: 0;
    transform: translateY(4px) scale(0.96);
    transform-origin: bottom right;
    transition: opacity 0.25s ease, transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    pointer-events: none;
  }

  .assistant-buddy:hover + .buddy-tooltip,
  .assistant-buddy:focus-visible + .buddy-tooltip,
  .buddy-tooltip.is-peeking {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  .assistant-head-identity {
    display: flex;
    align-items: center;
    gap: 0.7rem;
  }

  .buddy-avatar {
    flex-shrink: 0;
    width: 2rem;
    height: 2rem;
    border-radius: 999px;
    background: radial-gradient(circle at 34% 28%, #f5c47e, var(--color-accent) 55%, var(--color-accent-dim) 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: box-shadow 0.3s ease;
  }

  .buddy-avatar.is-thinking {
    animation: buddy-status-pulse 0.9s ease-in-out infinite;
    box-shadow: 0 0 0 3px var(--color-accent-soft);
  }

  .buddy-face-mini {
    width: 12px;
    height: 6px;
  }

  .buddy-face-mini .buddy-eye {
    width: 3.5px;
    height: 3.5px;
  }

  .assistant-panel {
    position: absolute;
    right: 0;
    bottom: calc(100% + 0.85rem);
    width: min(23rem, calc(100vw - 2.5rem));
    height: min(32rem, 70vh);
    display: flex;
    flex-direction: column;
    background: var(--color-surface-raised);
    border: 1px solid var(--color-border-strong);
    border-radius: 1rem;
    box-shadow: 0 30px 70px rgba(0, 0, 0, 0.5);
    overflow: hidden;
    transform-origin: bottom right;
    opacity: 0;
    transform: scale(0.94) translateY(10px);
    transition: opacity 0.25s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .assistant-panel.is-open {
    opacity: 1;
    transform: scale(1) translateY(0);
  }

  .assistant-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1.1rem;
    border-bottom: 1px solid var(--color-border);
  }

  .assistant-name {
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-text);
  }

  .assistant-meta {
    margin-top: 0.2rem;
    color: var(--color-text-faint);
  }

  .assistant-close {
    color: var(--color-text-faint);
    padding: 0.2rem;
    transition: color 0.2s ease;
  }

  .assistant-close:hover {
    color: var(--color-accent);
  }

  .assistant-close svg {
    width: 18px;
    height: 18px;
  }

  .assistant-log {
    flex: 1;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1rem 1.1rem;
  }

  .assistant-msg {
    max-width: 86%;
    padding: 0.6rem 0.85rem;
    border-radius: 0.75rem;
    font-size: 0.86rem;
    line-height: 1.55;
    animation: msg-in 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes msg-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .assistant-msg-user {
    align-self: flex-end;
    background: var(--color-accent);
    color: var(--color-ink);
    border-bottom-right-radius: 0.2rem;
  }

  .assistant-msg-bot {
    align-self: flex-start;
    background: var(--color-surface);
    color: var(--color-text);
    border: 1px solid var(--color-border);
    border-bottom-left-radius: 0.2rem;
  }

  .assistant-typing {
    display: flex;
    gap: 0.3rem;
    align-items: center;
    padding-block: 0.75rem;
  }

  .assistant-typing span {
    width: 5px;
    height: 5px;
    border-radius: 999px;
    background: var(--color-text-faint);
    animation: typing-bounce 1.1s ease-in-out infinite;
  }

  .assistant-typing span:nth-child(2) {
    animation-delay: 0.15s;
  }

  .assistant-typing span:nth-child(3) {
    animation-delay: 0.3s;
  }

  @keyframes typing-bounce {
    0%,
    60%,
    100% {
      transform: translateY(0);
      opacity: 0.5;
    }
    30% {
      transform: translateY(-3px);
      opacity: 1;
    }
  }

  .assistant-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    padding: 0 1.1rem 0.85rem;
  }

  .assistant-chip {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--color-text-muted);
    padding: 0.4rem 0.7rem;
    border: 1px solid var(--color-border-strong);
    border-radius: 0.5rem;
    transition: border-color 0.2s ease, color 0.2s ease, background-color 0.2s ease;
  }

  .assistant-chip:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
    background: var(--color-accent-soft);
  }

  .assistant-form {
    display: flex;
    gap: 0.6rem;
    padding: 0.85rem 1.1rem;
    border-top: 1px solid var(--color-border);
  }

  .assistant-input {
    flex: 1;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 0.6rem;
    padding: 0.55rem 0.8rem;
    font-size: 0.86rem;
    color: var(--color-text);
    transition: border-color 0.2s ease;
  }

  .assistant-input:focus {
    border-color: var(--color-accent);
  }

  .assistant-input:disabled {
    opacity: 0.6;
  }

  .assistant-send {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    flex-shrink: 0;
    background: var(--color-accent);
    color: var(--color-ink);
    border-radius: 0.6rem;
    transition: background-color 0.2s ease, transform 0.2s ease;
  }

  .assistant-send:hover {
    background: #f0b158;
    transform: translateY(-1px);
  }

  .assistant-send svg {
    width: 18px;
    height: 18px;
  }

  @media (max-width: 30rem) {
    .assistant-root {
      right: 1rem;
      bottom: 1rem;
      left: 1rem;
    }

    .buddy-wrap {
      margin-left: auto;
    }

    .assistant-panel {
      position: fixed;
      inset: auto 1rem 5.5rem 1rem;
      width: auto;
      height: min(30rem, 72vh);
      transform-origin: bottom center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .assistant-msg {
      animation: none;
    }
  }
</style>
