---
import { PROJECTS_WITH_CASE } from '../data/caseStudies';
import ProjectGlyph from './ProjectGlyph.astro';

const featured = PROJECTS_WITH_CASE.find((p) => p.featured);
const rest = PROJECTS_WITH_CASE.filter((p) => !p.featured);
const ordered = [featured, ...rest].filter(Boolean) as typeof PROJECTS_WITH_CASE;

const slug = (name: string) => `project-${name.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
---

<section id="projects" class="section" aria-labelledby="projects-heading">
  <div class="section-heading-row">
    <span class="section-number mono-tag">04</span>
    <h2 id="projects-heading" class="section-heading mask-reveal"><span class="mask-reveal-inner">Projects</span></h2>
  </div>
  <p class="projects-intro">Independent and team-led work, from a research-driven AI system to client-ready tools. Click any project for the full case study.</p>

  <div class="project-scenes">
    {ordered.map((project, i) => (
      <button
        type="button"
        id={slug(project.name)}
        class:list={['project-scene spotlight-card', { 'is-featured': project.featured }]}
        data-animate
        data-cursor
        data-cursor-text="Case Study"
        data-case-index={i}
      >
        <div class="project-scene-visual">
          <ProjectGlyph stack={project.stack} />
        </div>
        <div class="project-scene-copy">
          {project.featured && <span class="mono-tag project-flag">Flagship project</span>}
          <div class="project-scene-head">
            <h3>{project.name}</h3>
            <span class="mono-tag project-period">{project.period}</span>
          </div>
          <p class="project-role">{project.role}</p>
          <p class="project-description">{project.tagline}</p>

          <ul class="project-stack">
            {project.stack.map((t) => (
              <li>{t}</li>
            ))}
          </ul>

          <span class="project-view-cta">View case study</span>
        </div>
      </button>
    ))}
  </div>
</section>

<!-- Pre-rendered case-study content, one per project. Inert <template>s cost
     nothing at paint/layout time; the lazy-loaded runtime clones whichever
     one is needed into the overlay. Rendering this with Astro (rather than
     building HTML strings in JS) means the copy is real, crawlable markup
     and there's no risk of it drifting from the data. -->
{ordered.map((p, i) => (
  <template data-case-template data-case-index={i}>
    <article class="pcs-content">
      <header class="pcs-hero" data-animate-cs>
        <p class="pcs-eyebrow mono-tag">{p.featured ? 'Flagship project' : 'Project'} · {p.period}</p>
        <h2 class="pcs-title">{p.name}</h2>
        <p class="pcs-role">{p.role}</p>
        <ProjectGlyph stack={p.stack} compact />
      </header>

      <section class="pcs-section" data-animate-cs>
        <h3 class="pcs-heading mono-tag">Overview</h3>
        <p>{p.description}</p>
      </section>

      <section class="pcs-section" data-animate-cs>
        <h3 class="pcs-heading mono-tag">Problem</h3>
        <p>{p.case.problem}</p>
      </section>

      <section class="pcs-section" data-animate-cs>
        <h3 class="pcs-heading mono-tag">Solution</h3>
        <p>{p.case.solution}</p>
      </section>

      <section class="pcs-section" data-animate-cs>
        <h3 class="pcs-heading mono-tag">My Role</h3>
        <p>{p.role}</p>
      </section>

      <section class="pcs-section" data-animate-cs>
        <h3 class="pcs-heading mono-tag">Technologies Used</h3>
        <ul class="pcs-tags">
          {p.stack.map((t) => <li>{t}</li>)}
        </ul>
      </section>

      <section class="pcs-section" data-animate-cs>
        <h3 class="pcs-heading mono-tag">Key Features</h3>
        <ul class="pcs-list">
          {p.features.map((f) => <li>{f}</li>)}
        </ul>
      </section>

      <section class="pcs-section" data-animate-cs>
        <h3 class="pcs-heading mono-tag">Challenges</h3>
        <p>{p.case.challenges}</p>
      </section>

      <section class="pcs-section" data-animate-cs>
        <h3 class="pcs-heading mono-tag">How I Solved Them</h3>
        <p>{p.case.howSolved}</p>
      </section>

      <section class="pcs-section" data-animate-cs>
        <h3 class="pcs-heading mono-tag">Outcome</h3>
        <p>{p.case.outcome}</p>
      </section>

      {p.link && (
        <section class="pcs-section" data-animate-cs>
          <h3 class="pcs-heading mono-tag">Links</h3>
          <a href={p.link} target="_blank" rel="noopener noreferrer" class="pcs-link" data-cursor>
            View project <span aria-hidden="true">↗</span>
          </a>
        </section>
      )}

      <section class="pcs-section" data-animate-cs>
        <h3 class="pcs-heading mono-tag">Architecture</h3>
        <ProjectGlyph stack={p.stack} />
      </section>
    </article>
  </template>
))}

<div id="pcs-overlay" class="pcs-overlay" role="dialog" aria-modal="true" aria-label="Project case study" hidden>
  <header class="pcs-topbar">
    <button type="button" id="pcs-close" class="pcs-chip-btn" data-cursor>
      <span aria-hidden="true">←</span> Close
    </button>
    <div class="pcs-dots" id="pcs-dots" role="list" aria-label="Project navigation"></div>
    <div class="pcs-nav-buttons">
      <button type="button" id="pcs-prev" class="pcs-chip-btn" aria-label="Previous project" data-cursor>Prev</button>
      <button type="button" id="pcs-next" class="pcs-chip-btn" aria-label="Next project" data-cursor>Next</button>
    </div>
  </header>
  <div class="pcs-stage" id="pcs-stage" tabindex="-1"></div>
</div>

<script>
  import { gsap } from 'gsap';

  // Pointer-tracked spotlight glow only (no 3D tilt — a whole project scene
  // is too large an element to tilt without feeling broken rather than
  // premium; tilt stays reserved for small cards elsewhere in the site).
  const canHover =
    window.matchMedia('(hover: hover) and (pointer: fine)').matches &&
    !window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (canHover) {
    document.querySelectorAll<HTMLElement>('.spotlight-card').forEach((card) => {
      const state = { mx: 50, my: 50 };
      const setMx = gsap.quickTo(state, 'mx', {
        duration: 0.4,
        ease: 'power3.out',
        onUpdate: () => card.style.setProperty('--mx', `${state.mx}%`),
      });
      const setMy = gsap.quickTo(state, 'my', {
        duration: 0.4,
        ease: 'power3.out',
        onUpdate: () => card.style.setProperty('--my', `${state.my}%`),
      });

      card.addEventListener('pointermove', (e) => {
        const rect = card.getBoundingClientRect();
        setMx(((e.clientX - rect.left) / rect.width) * 100);
        setMy(((e.clientY - rect.top) / rect.height) * 100);
      });
    });
  }

  // Case study: dynamically imported only on first open, so it costs
  // nothing for a visitor who never clicks a project card.
  let mountCaseStudy: ((index: number) => void) | null = null;

  document.querySelectorAll<HTMLButtonElement>('[data-case-index]').forEach((card) => {
    card.addEventListener('click', async () => {
      const index = Number(card.dataset.caseIndex);
      if (!mountCaseStudy) {
        const mod = await import('../scripts/caseStudy');
        mountCaseStudy = mod.mountCaseStudy;
      }
      mountCaseStudy(index);
    });
  });
</script>

<style>
  .projects-intro {
    margin-top: 1rem;
    max-width: 34rem;
    color: var(--color-text-muted);
  }

  .project-scenes {
    margin-top: 3.5rem;
    display: flex;
    flex-direction: column;
    gap: 4.5rem;
  }

  .project-scene {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    width: 100%;
    text-align: left;
    font: inherit;
    color: inherit;
    cursor: pointer;
  }

  .project-scene-visual :global(.glyph-full) {
    transition: border-color 0.3s ease, transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .project-scene:hover .project-scene-visual :global(.glyph-full) {
    border-color: var(--color-border-strong);
    transform: translateY(-3px);
  }

  .project-scene.is-featured .project-scene-visual :global(.glyph-full) {
    border-color: var(--color-accent-dim);
  }

  .project-flag {
    display: inline-block;
    margin-bottom: 0.6rem;
    color: var(--color-accent);
  }

  .project-scene-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
  }

  .project-scene-head h3 {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 1.2rem + 1.6vw, 2.15rem);
    font-weight: 600;
    color: var(--color-text);
  }

  .project-period {
    color: var(--color-text-faint);
    white-space: nowrap;
  }

  .project-role {
    margin-top: 0.4rem;
    font-size: 0.9rem;
    color: var(--color-signal);
  }

  .project-description {
    margin-top: 1.1rem;
    color: var(--color-text-muted);
    line-height: 1.7;
    font-size: 1.05rem;
    max-width: 32rem;
  }

  .project-stack {
    margin-top: 1.5rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .project-stack li {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-text-faint);
    padding: 0.25rem 0.55rem;
    border: 1px solid var(--color-border);
    border-radius: 0.35rem;
    transition: border-color 0.2s ease, color 0.2s ease;
    transition-delay: calc(var(--i, 0) * 30ms);
  }

  .project-scene:hover .project-stack li {
    border-color: var(--color-accent-dim);
  }

  .project-view-cta {
    position: relative;
    margin-top: 1.75rem;
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--color-text-faint);
    transition: color 0.2s ease;
  }

  .project-view-cta::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -3px;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .project-scene:hover .project-view-cta {
    color: var(--color-accent);
  }

  .project-scene:hover .project-view-cta::after {
    transform: scaleX(1);
  }

  @media (min-width: 56rem) {
    .project-scene {
      flex-direction: row;
      align-items: center;
      gap: 4rem;
    }

    .project-scene-visual {
      flex: 0 0 45%;
    }

    .project-scene-copy {
      flex: 1;
      min-width: 0;
    }

    .project-scene:nth-child(even) {
      flex-direction: row-reverse;
    }
  }
</style>

<style is:global>
  /* Case-study overlay — global because content is cloned at runtime from
     <template>s, outside Astro's component-scoping. Namespaced pcs-. */

  .pcs-overlay {
    position: fixed;
    inset: 0;
    z-index: 150;
    display: flex;
    flex-direction: column;
    background: var(--color-ink);
    opacity: 0;
    transform: scale(0.98);
    transition: opacity 0.25s cubic-bezier(0.16, 1, 0.3, 1), transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .pcs-overlay.is-open {
    opacity: 1;
    transform: scale(1);
  }

  .pcs-topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 1rem 1.25rem;
    border-bottom: 1px solid var(--color-border);
    flex-shrink: 0;
  }

  .pcs-dots {
    display: flex;
    gap: 0.4rem;
  }

  .pcs-dot {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: var(--color-border-strong);
    transition: background-color 0.25s ease, transform 0.25s ease;
  }

  .pcs-dot.is-current {
    background: var(--color-accent);
    transform: scale(1.3);
  }

  .pcs-nav-buttons {
    display: flex;
    gap: 0.5rem;
  }

  .pcs-chip-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    padding: 0.45rem 0.8rem;
    border: 1px solid var(--color-border-strong);
    border-radius: 0.45rem;
    color: var(--color-text-muted);
    transition: border-color 0.2s ease, color 0.2s ease;
  }

  .pcs-chip-btn:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .pcs-stage {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    padding: 2.5rem 1.5rem 4rem;
  }

  .pcs-stage:focus {
    outline: none;
  }

  .pcs-content {
    margin-inline: auto;
    width: 100%;
    max-width: 40rem;
  }

  .pcs-eyebrow {
    color: var(--color-accent);
  }

  .pcs-title {
    margin-top: 0.6rem;
    font-family: var(--font-display);
    font-size: clamp(2rem, 1.6rem + 2vw, 2.75rem);
    font-weight: 600;
    color: var(--color-text);
  }

  .pcs-role {
    margin-top: 0.4rem;
    color: var(--color-signal);
    font-size: 0.95rem;
  }

  .pcs-hero :global(.glyph-compact) {
    margin-top: 1.5rem;
  }

  .pcs-section {
    margin-top: 3rem;
    padding-top: 2.25rem;
    border-top: 1px solid var(--color-border);
  }

  .pcs-heading {
    color: var(--color-accent);
  }

  .pcs-section p {
    margin-top: 0.85rem;
    color: var(--color-text-muted);
    line-height: 1.7;
    max-width: 36rem;
  }

  .pcs-tags {
    margin-top: 1rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .pcs-tags li {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--color-text-muted);
    padding: 0.4rem 0.75rem;
    border: 1px solid var(--color-border-strong);
    border-radius: 0.45rem;
  }

  .pcs-list {
    margin-top: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .pcs-list li {
    position: relative;
    padding-left: 1.2rem;
    color: var(--color-text-muted);
    line-height: 1.65;
    max-width: 36rem;
  }

  .pcs-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.65em;
    width: 6px;
    height: 1px;
    background: var(--color-text-faint);
  }

  .pcs-link {
    margin-top: 1rem;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--color-accent);
    font-size: 0.9rem;
    border-bottom: 1px solid var(--color-accent-dim);
    padding-bottom: 0.15rem;
    transition: border-color 0.2s ease;
  }

  .pcs-link:hover {
    border-color: var(--color-accent);
  }

  @media (prefers-reduced-motion: reduce) {
    .pcs-overlay {
      transition: none;
    }
  }
</style>
