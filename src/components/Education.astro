---
import { education, certifications } from '../data/resume';
---

<section id="education" class="section" aria-labelledby="education-heading">
  <h2 id="education-heading" class="section-heading mask-reveal"><span class="mask-reveal-inner">Education</span></h2>

  <div class="education-card" data-animate>
    <div>
      <h3>{education.degree}</h3>
      <p class="education-status mono-tag">{education.status}</p>
    </div>
  </div>

  <div class="certifications" data-animate>
    <h3 class="certifications-title">Certifications &amp; training</h3>
    <ul class="certifications-list">
      {certifications.map((c) => (
        <li>{c}</li>
      ))}
    </ul>
  </div>
</section>

<style>
  .education-card {
    margin-top: 1.75rem;
    padding: 1.75rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
  }

  .education-card h3 {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--color-text);
  }

  .education-status {
    margin-top: 0.4rem;
    color: var(--color-accent);
  }

  .certifications {
    margin-top: 2.25rem;
  }

  .certifications-title {
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-text);
  }

  .certifications-list {
    margin-top: 1rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .certifications-list li {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    padding: 0.5rem 0.9rem;
    border: 1px solid var(--color-border-strong);
    border-radius: 0.5rem;
  }
</style>
