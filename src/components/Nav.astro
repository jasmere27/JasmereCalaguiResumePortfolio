---
import { profile, nav } from '../data/resume';

const initials = profile.name
  .split(' ')
  .map((w) => w[0])
  .join('');
---

<header class="site-nav" id="site-nav">
  <!-- Desktop rail -->
  <div class="rail">
    <a href="#main" class="rail-mark" data-cursor>
      <span class="rail-mark-glyph">{initials}</span>
    </a>

    <nav aria-label="Section navigation" class="rail-nav">
      <div class="rail-track">
        <span class="rail-track-line" aria-hidden="true"></span>
        <span class="rail-track-progress" id="rail-progress" aria-hidden="true"></span>
        <ul>
          {nav.map((item, i) => (
            <li style={`--i: ${i}`}>
              <a href={item.href} data-nav-link data-target={item.href.slice(1)} data-cursor>
                <span class="rail-dot" aria-hidden="true"></span>
                <span class="rail-label">{item.label}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </nav>

    <div class="rail-footer">
      <button type="button" class="cmdk-open-trigger rail-cmdk-trigger" data-cursor>
        <span>Quick search</span>
        <kbd class="mono-tag">Ctrl K</kbd>
      </button>
      <a href="/jasmere-paul-calagui-resume.pdf" class="rail-footer-link" download data-cursor>Download résumé</a>
      <a href={`mailto:${profile.email}`} class="rail-footer-link" data-cursor>{profile.email}</a>
    </div>
  </div>

  <!-- Mobile top bar -->
  <div class="topbar" id="topbar">
    <a href="#main" class="topbar-mark">{profile.name}</a>
    <button
      id="menu-toggle"
      class="topbar-toggle"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Toggle navigation menu"
    >
      <span class="toggle-line"></span>
      <span class="toggle-line"></span>
    </button>
  </div>

  <div id="mobile-menu" class="mobile-menu" data-open="false">
    <nav aria-label="Mobile section navigation">
      <ul>
        {nav.map((item) => (
          <li>
            <a href={item.href} data-mobile-link>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="mobile-menu-footer">
      <button type="button" class="cmdk-open-trigger mobile-cmdk-trigger">
        <span>Quick search</span>
        <kbd class="mono-tag">Ctrl K</kbd>
      </button>
      <a href="/jasmere-paul-calagui-resume.pdf" class="mobile-menu-link" download>Download résumé</a>
      <a href={`mailto:${profile.email}`} class="mobile-menu-email">{profile.email}</a>
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');

  function closeMenu() {
    menu?.setAttribute('data-open', 'false');
    toggle?.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
  }

  toggle?.addEventListener('click', () => {
    const isOpen = menu?.getAttribute('data-open') === 'true';
    menu?.setAttribute('data-open', String(!isOpen));
    toggle.setAttribute('aria-expanded', String(!isOpen));
    document.body.style.overflow = isOpen ? '' : 'hidden';
  });

  document.querySelectorAll('[data-mobile-link]').forEach((link) => {
    link.addEventListener('click', closeMenu);
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeMenu();
  });

  // Scroll-spy: highlight the active section in the desktop rail.
  const navLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]'));
  const sections = navLinks
    .map((link) => document.getElementById(link.dataset.target ?? ''))
    .filter((el): el is HTMLElement => el !== null);

  const setActive = (id: string) => {
    navLinks.forEach((link) => {
      link.toggleAttribute('data-active', link.dataset.target === id);
    });
  };

  if ('IntersectionObserver' in window && sections.length) {
    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((e) => e.isIntersecting)
          .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
        if (visible) setActive(visible.target.id);
      },
      { rootMargin: '-20% 0px -60% 0px', threshold: [0, 0.25, 0.5, 1] }
    );
    sections.forEach((s) => observer.observe(s));
  }

  // Scroll-progress trace fill on the desktop rail + nav scrolled state,
  // sharing one rAF-throttled scroll listener.
  const progressEl = document.getElementById('rail-progress');
  const topbar = document.getElementById('topbar');
  const siteNav = document.getElementById('site-nav');
  const rail = document.querySelector<HTMLElement>('.rail');

  // The nav carries no chrome over the hero — it slides/fades in once the
  // visitor has mostly scrolled past it, and hides again on the way back up.
  // `inert` (not just opacity) keeps its links out of the tab order while
  // hidden, matching what's already visually true.
  const hero = document.getElementById('hero');
  function setNavRevealed(revealed: boolean) {
    siteNav?.classList.toggle('nav-revealed', revealed);
    if (rail) rail.inert = !revealed;
    if (topbar) topbar.inert = !revealed;
  }

  if (hero && 'IntersectionObserver' in window) {
    new IntersectionObserver(([entry]) => setNavRevealed(!entry.isIntersecting), {
      rootMargin: '0px 0px -60% 0px',
      threshold: 0,
    }).observe(hero);
  } else {
    setNavRevealed(true);
  }

  let ticking = false;
  const updateOnScroll = () => {
    const max = document.documentElement.scrollHeight - window.innerHeight;
    const pct = max > 0 ? Math.min(Math.max(window.scrollY / max, 0), 1) : 0;
    if (progressEl) progressEl.style.height = `${pct * 100}%`;

    const scrolled = window.scrollY > 12;
    topbar?.classList.toggle('is-scrolled', scrolled);
    siteNav?.classList.toggle('is-scrolled', scrolled);
    ticking = false;
  };

  updateOnScroll();
  window.addEventListener(
    'scroll',
    () => {
      if (!ticking) {
        requestAnimationFrame(updateOnScroll);
        ticking = true;
      }
    },
    { passive: true }
  );
  window.addEventListener('resize', updateOnScroll);
</script>

<style>
  .rail {
    display: none;
  }

  .topbar {
    position: fixed;
    inset-inline: 0;
    top: 0;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.15rem 1.25rem;
    background: transparent;
    backdrop-filter: blur(0px);
    border-bottom: 1px solid transparent;
    opacity: 0;
    transform: translateY(-0.6rem);
    pointer-events: none;
    transition: padding 0.35s cubic-bezier(0.16, 1, 0.3, 1), background-color 0.35s ease,
      border-color 0.35s ease, backdrop-filter 0.35s ease,
      opacity 0.5s cubic-bezier(0.16, 1, 0.3, 1), transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .nav-revealed .topbar {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .topbar.is-scrolled {
    padding-block: 0.8rem;
    background: color-mix(in srgb, var(--color-ink) 88%, transparent);
    backdrop-filter: blur(10px);
    border-bottom-color: var(--color-border);
  }

  .topbar-mark {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--color-text);
  }

  .topbar-toggle {
    display: flex;
    flex-direction: column;
    gap: 5px;
    width: 28px;
    padding: 6px 0;
  }

  .toggle-line {
    height: 1.5px;
    background: var(--color-text);
    border-radius: 1px;
    transition: transform 0.25s ease, opacity 0.25s ease;
  }

  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 45;
    padding: 6.5rem 1.5rem 2rem;
    background: var(--color-ink);
    transform: translateY(-8px);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.25s ease, transform 0.25s ease, visibility 0.25s;
  }

  .mobile-menu[data-open='true'] {
    opacity: 1;
    transform: translateY(0);
    visibility: visible;
  }

  .mobile-menu ul {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .mobile-menu a[data-mobile-link] {
    display: block;
    padding: 0.85rem 0;
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 500;
    color: var(--color-text);
    border-bottom: 1px solid var(--color-border);
  }

  .mobile-menu-footer {
    margin-top: 2rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
  }

  .mobile-menu-link {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }

  .mobile-menu-email {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--color-accent);
  }

  .mobile-cmdk-trigger {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.6rem 0.9rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border-strong);
    border-radius: 0.5rem;
    color: var(--color-text-muted);
    font-size: 0.85rem;
  }

  .mobile-cmdk-trigger kbd {
    padding: 0.15rem 0.4rem;
    border: 1px solid var(--color-border-strong);
    border-radius: 0.3rem;
    font-size: 0.7rem;
    color: var(--color-text-faint);
  }

  @media (min-width: 64rem) {
    .topbar,
    .mobile-menu {
      display: none;
    }

    .rail {
      display: flex;
      flex-direction: column;
      position: fixed;
      inset-block: 0;
      left: 0;
      width: 17rem;
      padding: 3rem 2.5rem;
      border-right: 1px solid var(--color-border);
      opacity: 0;
      transform: translateX(-0.75rem);
      pointer-events: none;
      transition: border-color 0.4s ease, opacity 0.5s cubic-bezier(0.16, 1, 0.3, 1),
        transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .nav-revealed .rail {
      opacity: 1;
      transform: translateX(0);
      pointer-events: auto;
    }

    .site-nav.is-scrolled .rail {
      border-right-color: var(--color-border-strong);
    }

    .rail-mark-glyph {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 2.75rem;
      height: 2.75rem;
      border: 1px solid var(--color-border-strong);
      border-radius: 0.6rem;
      font-family: var(--font-display);
      font-weight: 600;
      font-size: 0.95rem;
      color: var(--color-accent);
    }

    .rail-nav {
      margin-top: 3.5rem;
    }

    .rail-track {
      position: relative;
      padding-left: 1.1rem;
    }

    .rail-track-line {
      position: absolute;
      left: 0;
      top: 0;
      bottom: 0;
      width: 1px;
      background: var(--color-border);
    }

    .rail-track-progress {
      position: absolute;
      left: -0.5px;
      top: 0;
      width: 2px;
      height: 0%;
      background: var(--color-accent);
      box-shadow: 0 0 8px var(--color-accent-soft);
    }

    .rail-nav ul {
      display: flex;
      flex-direction: column;
      gap: 1.6rem;
      position: relative;
    }

    .rail-nav a {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      font-size: 0.9rem;
      color: var(--color-text-faint);
      transition: color 0.2s ease;
    }

    .rail-nav a:hover {
      color: var(--color-text-muted);
    }

    .rail-label {
      position: relative;
    }

    .rail-label::after {
      content: '';
      position: absolute;
      left: 0;
      right: 0;
      bottom: -3px;
      height: 1px;
      background: currentColor;
      transform: scaleX(0);
      transform-origin: left;
      transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .rail-nav a:hover .rail-label::after,
    .rail-nav a[data-active] .rail-label::after {
      transform: scaleX(1);
    }

    .rail-dot {
      width: 6px;
      height: 6px;
      margin-left: -1.35rem;
      border-radius: 999px;
      background: var(--color-border-strong);
      transition: background-color 0.25s ease, box-shadow 0.25s ease;
    }

    .rail-nav a[data-active] {
      color: var(--color-text);
    }

    .rail-nav a[data-active] .rail-dot {
      background: var(--color-accent);
      box-shadow: 0 0 0 3px var(--color-accent-soft);
    }

    .rail-footer {
      margin-top: auto;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 0.85rem;
    }

    .rail-footer-link {
      font-family: var(--font-mono);
      font-size: 0.75rem;
      color: var(--color-text-faint);
      word-break: break-all;
      transition: color 0.2s ease;
    }

    .rail-footer-link:hover {
      color: var(--color-accent);
    }

    .rail-cmdk-trigger {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.75rem;
      width: 100%;
      padding: 0.5rem 0.7rem;
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: 0.5rem;
      color: var(--color-text-faint);
      font-size: 0.8rem;
      transition: border-color 0.2s ease, color 0.2s ease;
    }

    .rail-cmdk-trigger:hover {
      border-color: var(--color-border-strong);
      color: var(--color-text-muted);
    }

    .rail-cmdk-trigger kbd {
      padding: 0.15rem 0.4rem;
      border: 1px solid var(--color-border-strong);
      border-radius: 0.3rem;
      font-size: 0.68rem;
    }
  }
</style>
