---
// Entry point only. The actual game logic (src/game/careerQuest.ts) is
// dynamically imported on click, so it adds zero weight to the initial
// portfolio load if a visitor never plays.
---

<section id="career-quest" class="section cq-entry-section" aria-labelledby="career-quest-heading">
  <div class="cq-entry-card" data-animate>
    <div class="cq-entry-copy">
      <p class="cq-entry-eyebrow mono-tag">Optional · about 3 minutes</p>
      <h2 id="career-quest-heading" class="cq-entry-title">Play My Career Quest</h2>
      <p class="cq-entry-lede">
        Explore my experience through an interactive developer journey — seven short stops through my
        real education, projects, and skills. Entirely optional; everything above already tells the story.
      </p>
      <button type="button" class="cq-btn cq-btn-primary" id="career-quest-launch" data-cursor data-cursor-text="Play">
        Play My Career Quest
      </button>
    </div>
    <div class="cq-entry-visual" aria-hidden="true">
      <span class="cq-entry-node cq-entry-node-1"></span>
      <span class="cq-entry-node cq-entry-node-2"></span>
      <span class="cq-entry-node cq-entry-node-3"></span>
      <span class="cq-entry-line cq-entry-line-1"></span>
      <span class="cq-entry-line cq-entry-line-2"></span>
    </div>
  </div>
</section>

<div id="career-quest-overlay" class="cq-overlay" role="dialog" aria-modal="true" aria-label="Career Quest" hidden></div>

<script>
  const launchBtn = document.getElementById('career-quest-launch');
  const overlay = document.getElementById('career-quest-overlay');

  if (launchBtn && overlay) {
    let unmount: (() => void) | null = null;
    let lastFocused: HTMLElement | null = null;

    function closeGame() {
      overlay!.classList.remove('is-open');
      document.body.style.overflow = '';
      window.setTimeout(() => {
        overlay!.hidden = true;
        unmount?.();
        unmount = null;
      }, 250);
      lastFocused?.focus();
    }

    async function openGame() {
      lastFocused = document.activeElement as HTMLElement;
      overlay!.hidden = false;
      overlay!.innerHTML = '<div class="cq-loading">Loading Career Quest…</div>';
      document.body.style.overflow = 'hidden';
      requestAnimationFrame(() => overlay!.classList.add('is-open'));

      try {
        // Wait for web fonts alongside the module import. Self-hosted
        // fonts can still be swapping in shortly after page load; if a
        // reflow lands mid-interaction it shifts every element below it —
        // confirmed directly: a button's own screen position varied by
        // dozens of pixels across otherwise-identical runs, occasionally
        // moving out from under a click already in flight. Real visitors
        // reach this game after scrolling most of the page, so fonts are
        // essentially always settled by then — this just makes it certain.
        const fontsReady = 'fonts' in document ? document.fonts.ready : Promise.resolve();
        const [mod] = await Promise.all([import('../game/careerQuest'), fontsReady]);
        unmount = mod.mountCareerQuest(overlay!, closeGame);
      } catch {
        overlay!.innerHTML =
          '<div class="cq-loading">Could not load Career Quest right now.<br /><button type="button" class="cq-btn cq-btn-ghost" id="cq-error-close">Close</button></div>';
        document.getElementById('cq-error-close')?.addEventListener('click', closeGame);
      }
    }

    launchBtn.addEventListener('click', openGame);
  }
</script>

<style>
  .cq-entry-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 2rem;
    margin-top: 1rem;
    padding: 2rem;
    background: linear-gradient(155deg, var(--color-surface) 0%, var(--color-surface-raised) 100%);
    border: 1px solid var(--color-border-strong);
    border-radius: 1rem;
    overflow: hidden;
  }

  .cq-entry-eyebrow {
    color: var(--color-accent);
  }

  .cq-entry-title {
    margin-top: 0.6rem;
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 1.2rem + 1vw, 1.8rem);
    font-weight: 600;
    color: var(--color-text);
  }

  .cq-entry-lede {
    margin-top: 0.85rem;
    max-width: 34rem;
    color: var(--color-text-muted);
    line-height: 1.65;
  }

  .cq-entry-card .cq-btn {
    margin-top: 1.5rem;
  }

  .cq-entry-visual {
    position: relative;
    height: 4rem;
    opacity: 0.7;
  }

  .cq-entry-node {
    position: absolute;
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: var(--color-accent);
  }

  .cq-entry-node-1 {
    left: 6%;
    top: 20%;
  }
  .cq-entry-node-2 {
    left: 46%;
    top: 70%;
    background: var(--color-signal);
  }
  .cq-entry-node-3 {
    left: 86%;
    top: 30%;
  }

  .cq-entry-line {
    position: absolute;
    height: 1px;
    background: var(--color-border-strong);
    transform-origin: left center;
  }

  .cq-entry-line-1 {
    left: 6%;
    top: 20%;
    width: 42%;
    transform: rotate(30deg);
  }

  .cq-entry-line-2 {
    left: 48%;
    top: 70%;
    width: 40%;
    transform: rotate(-25deg);
  }

  @media (min-width: 40rem) {
    .cq-entry-card {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 2.5rem;
    }

    .cq-entry-visual {
      width: 12rem;
      height: 6rem;
      flex-shrink: 0;
    }
  }
</style>

<style is:global>
  /* ---------------------------------------------------------------------
     Career Quest overlay — styles are global because the game's DOM is
     built at runtime (innerHTML) by careerQuest.ts, outside Astro's
     component-scoping. Everything is namespaced with a cq- prefix.
     --------------------------------------------------------------------- */

  .cq-overlay {
    position: fixed;
    inset: 0;
    z-index: 150;
    display: flex;
    flex-direction: column;
    background: var(--color-ink);
    opacity: 0;
    transform: scale(0.98);
    transition: opacity 0.25s cubic-bezier(0.16, 1, 0.3, 1), transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .cq-overlay.is-open {
    opacity: 1;
    transform: scale(1);
  }

  .cq-loading {
    margin: auto;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.9rem;
    text-align: center;
  }

  .cq-topbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 1rem 1.25rem;
    border-bottom: 1px solid var(--color-border);
    flex-shrink: 0;
  }

  .cq-topbar-left {
    display: flex;
    align-items: baseline;
    gap: 0.9rem;
    min-width: 0;
  }

  .cq-wordmark {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--color-accent);
    flex-shrink: 0;
  }

  .cq-mission {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--color-text-faint);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .cq-progress {
    display: flex;
    gap: 0.4rem;
  }

  .cq-dot {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: var(--color-border-strong);
    transition: background-color 0.25s ease, transform 0.25s ease;
  }

  .cq-dot.is-done {
    background: var(--color-signal);
  }

  .cq-dot.is-current {
    background: var(--color-accent);
    transform: scale(1.3);
  }

  .cq-topbar-right {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .cq-score-badge {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--color-text-faint);
  }

  .cq-score-badge strong {
    color: var(--color-accent);
    font-variant-numeric: tabular-nums;
  }

  .cq-chip-btn {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    padding: 0.4rem 0.75rem;
    border: 1px solid var(--color-border-strong);
    border-radius: 0.4rem;
    color: var(--color-text-muted);
    transition: border-color 0.2s ease, color 0.2s ease;
  }

  .cq-chip-btn:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .cq-chip-btn.cq-exit:hover {
    border-color: var(--color-signal);
    color: var(--color-signal);
  }

  .cq-stage {
    /* Deliberately NOT display:flex. Flexbox's margin:auto centering trick
       combined with overflow-y:auto has a well-known cross-browser bug:
       once content is taller than the viewport, the overflow at one edge
       can become unreachable by scrolling — verified here, it clipped the
       Continue button just past the visible area on short viewports.
       Plain block flow + horizontal auto-margins on .cq-panel gives the
       same centered look with no such risk: vertical auto-margins on a
       block box simply resolve to 0 (top-aligned), which is exactly what a
       scrollable container needs.

       min-height: 0 is the actual fix for the underlying bug, though: a
       flex item's min-height defaults to `auto`, which means it grows to
       fit its content and ignores flex:1 the moment content exceeds the
       parent's height — so overflow-y:auto never engages at all. Verified
       directly: without this, .cq-stage's clientHeight matched its
       scrollHeight (both ~1036px) inside an 844px-tall overlay, meaning
       content past the fold was flat-out unreachable by scroll on mobile,
       not just visually clipped. */
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    padding: 2rem 1.5rem 3rem;
  }

  .cq-stage:focus {
    outline: none;
  }

  .cq-panel {
    margin: auto;
    width: 100%;
    max-width: 34rem;
  }

  .cq-kicker,
  .cq-eyebrow {
    color: var(--color-accent);
  }

  .cq-title {
    margin-top: 0.6rem;
    font-family: var(--font-display);
    font-size: clamp(2rem, 1.6rem + 2vw, 2.75rem);
    font-weight: 600;
    color: var(--color-text);
  }

  .cq-panel h2 {
    margin-top: 0.6rem;
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 1.2rem + 1vw, 1.9rem);
    font-weight: 600;
    color: var(--color-text);
  }

  .cq-panel h3 {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--color-text);
  }

  .cq-lede {
    margin-top: 1rem;
    color: var(--color-text-muted);
    line-height: 1.65;
  }

  .cq-outline {
    margin-top: 1.75rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
  }

  .cq-outline li {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-text-faint);
    padding: 0.4rem 0.7rem;
    border: 1px solid var(--color-border);
    border-radius: 0.4rem;
  }

  .cq-btn {
    display: inline-flex;
    align-items: center;
    padding: 0.7rem 1.3rem;
    font-size: 0.88rem;
    font-weight: 600;
    border-radius: 0.55rem;
    transition: transform 0.2s ease, border-color 0.2s ease, background-color 0.2s ease, color 0.2s ease;
    cursor: pointer;
  }

  .cq-btn-primary {
    background: var(--color-accent);
    color: var(--color-ink);
    margin-top: 1.75rem;
  }

  .cq-btn-primary:hover {
    background: #f0b158;
    transform: translateY(-1px);
  }

  .cq-btn-ghost {
    border: 1px solid var(--color-border-strong);
    color: var(--color-text);
  }

  .cq-btn-ghost:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  /* Education */
  .cq-badge-grid {
    margin-top: 1.5rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .cq-badge {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    padding: 0.55rem 0.9rem;
    border: 1px solid var(--color-border-strong);
    border-radius: 0.5rem;
    color: var(--color-text-muted);
    transition: border-color 0.2s ease, color 0.2s ease, background-color 0.2s ease, opacity 0.2s ease;
  }

  .cq-badge:hover:not(:disabled) {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .cq-badge.is-collected {
    border-color: var(--color-signal);
    background: var(--color-signal-soft);
    color: var(--color-signal);
    opacity: 0.85;
  }

  .cq-reveal {
    margin-top: 2rem;
    padding: 1.5rem 1.75rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border-strong);
    border-radius: 0.85rem;
  }

  .cq-cap {
    display: inline-block;
    width: 2rem;
    height: 2rem;
    border-radius: 0.4rem;
    background: var(--color-accent-soft);
    border: 1px solid var(--color-accent-dim);
    position: relative;
  }

  .cq-cap::after {
    content: '';
    position: absolute;
    inset: 6px;
    border: 1px solid var(--color-accent);
    border-radius: 2px;
  }

  .cq-accent {
    color: var(--color-accent);
    margin-top: 0.3rem;
  }

  /* Development */
  .cq-code {
    margin-top: 1.25rem;
    padding: 1rem 1.25rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--color-text-muted);
    overflow-x: auto;
    white-space: pre;
  }

  .cq-options,
  .cq-choices {
    margin-top: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .cq-option,
  .cq-choice {
    text-align: left;
    padding: 0.75rem 1rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border-strong);
    border-radius: 0.55rem;
    color: var(--color-text);
    font-size: 0.88rem;
    transition: border-color 0.2s ease, background-color 0.2s ease, transform 0.12s ease;
  }

  .cq-option code {
    font-family: var(--font-mono);
    font-size: 0.85rem;
  }

  .cq-option:hover:not(:disabled),
  .cq-choice:hover:not(:disabled) {
    border-color: var(--color-accent);
  }

  .cq-option.is-correct,
  .cq-choice.is-correct {
    border-color: var(--color-signal);
    background: var(--color-signal-soft);
  }

  .cq-option.is-wrong {
    animation: cq-shake 0.4s ease;
    border-color: var(--color-accent-dim);
  }

  .cq-choice.is-wrong {
    border-color: var(--color-border-strong);
    opacity: 0.6;
  }

  @keyframes cq-shake {
    0%,
    100% {
      transform: translateX(0);
    }
    25% {
      transform: translateX(-4px);
    }
    75% {
      transform: translateX(4px);
    }
  }

  .cq-feedback {
    margin-top: 1.1rem;
    font-size: 0.88rem;
    color: var(--color-text-muted);
  }

  .cq-feedback.is-good {
    color: var(--color-signal);
  }

  /* Experience */
  .cq-exp-card {
    padding-block: 1rem;
    border-top: 1px solid var(--color-border);
  }

  .cq-exp-card:first-child {
    border-top: none;
    padding-top: 0;
  }

  .cq-exp-head {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    color: var(--color-text);
  }

  .cq-exp-org {
    margin-top: 0.2rem;
    color: var(--color-accent);
    font-size: 0.85rem;
  }

  .cq-exp-card p:last-child {
    margin-top: 0.5rem;
    color: var(--color-text-muted);
    font-size: 0.9rem;
    line-height: 1.6;
  }

  /* AI / Technology */
  .cq-ai-core {
    margin: 1.75rem auto 0;
    width: 5rem;
    height: 5rem;
    border-radius: 999px;
    background: radial-gradient(circle at 35% 30%, #f5c47e, var(--color-accent) 55%, var(--color-accent-dim) 100%);
    opacity: calc(0.35 + var(--charge, 0) * 0.65);
    box-shadow: 0 0 calc(var(--charge, 0) * 50px) var(--color-accent-soft);
    transition: opacity 0.3s ease, box-shadow 0.3s ease;
  }

  .cq-ai-grid {
    margin-top: 1.75rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.6rem;
  }

  .cq-ai-node {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    padding: 0.55rem 0.9rem;
    border: 1px solid var(--color-border-strong);
    border-radius: 999px;
    color: var(--color-text-muted);
    transition: border-color 0.2s ease, color 0.2s ease, background-color 0.2s ease;
  }

  .cq-ai-node:hover:not(:disabled) {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .cq-ai-node.is-active {
    border-color: var(--color-accent);
    background: var(--color-accent-soft);
    color: var(--color-accent);
    opacity: 0.85;
  }

  /* VeriFact */
  .cq-claim-flag {
    margin-top: 1.5rem;
    color: var(--color-signal);
    letter-spacing: 0.05em;
  }

  .cq-claim {
    margin: 0.75rem 0 0;
    padding: 1rem 1.25rem;
    border-left: 2px solid var(--color-accent);
    background: var(--color-surface);
    font-size: 1rem;
    color: var(--color-text);
    font-style: italic;
  }

  .cq-pipeline {
    margin-top: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding-left: 1.1rem;
    border-left: 1px solid var(--color-border);
  }

  .cq-pipe-stage {
    position: relative;
  }

  .cq-pipe-dot {
    position: absolute;
    left: -1.44rem;
    top: 0.3rem;
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: var(--color-ink);
    border: 2px solid var(--color-accent);
  }

  .cq-pipe-stage strong {
    color: var(--color-text);
    font-family: var(--font-display);
  }

  .cq-pipe-stage p {
    margin-top: 0.25rem;
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }

  .cq-disclaimer {
    font-size: 0.8rem;
    font-style: italic;
    color: var(--color-text-faint);
  }

  .cq-feature-list {
    margin-top: 0.75rem;
    padding-left: 1.1rem;
    color: var(--color-text-muted);
    font-size: 0.88rem;
    line-height: 1.7;
  }

  /* Tech stack collectibles */
  .cq-collect-grid {
    margin-top: 1.5rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
  }

  .cq-collect-chip {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    padding: 0.5rem 0.85rem;
    border: 1px solid var(--color-border-strong);
    border-radius: 0.5rem;
    color: var(--color-text-muted);
    transition: border-color 0.2s ease, color 0.2s ease, background-color 0.2s ease;
  }

  .cq-collect-chip:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .cq-collect-chip.is-collected {
    border-color: var(--color-signal);
    color: var(--color-signal);
    background: var(--color-signal-soft);
  }

  .cq-tech-detail {
    margin-top: 1.5rem;
    min-height: 6rem;
    padding: 1.25rem 1.5rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 0.7rem;
  }

  .cq-tech-detail .cq-hint {
    color: var(--color-text-faint);
    font-size: 0.88rem;
  }

  .cq-tech-links {
    margin-top: 0.6rem;
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }

  .cq-tech-note {
    margin-top: 0.75rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--color-border);
    font-size: 0.82rem;
    color: var(--color-text-faint);
  }

  .cq-collect-progress {
    margin-top: 1rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--color-text-faint);
  }

  .cq-collect-progress strong {
    color: var(--color-accent);
  }

  /* Mission Complete */
  .cq-summary-grid {
    margin-top: 1.75rem;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }

  .cq-summary-grid > div {
    padding: 1rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 0.6rem;
    text-align: center;
  }

  .cq-summary-grid strong {
    display: block;
    font-family: var(--font-display);
    font-size: 1.6rem;
    color: var(--color-accent);
  }

  .cq-summary-grid span {
    font-size: 0.78rem;
    color: var(--color-text-faint);
  }

  .cq-score-line {
    margin-top: 1.5rem;
    color: var(--color-text-muted);
  }

  .cq-score-line strong {
    color: var(--color-accent);
  }

  .cq-cta-row {
    margin-top: 1.5rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  @media (min-width: 30rem) {
    .cq-summary-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  @media (max-width: 40rem) {
    .cq-topbar {
      gap: 0.5rem;
    }

    .cq-mission {
      display: none;
    }

    .cq-score-badge {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cq-overlay {
      transition: none;
    }

    .cq-option.is-wrong {
      animation: none;
    }
  }
</style>
