---
import { experience } from '../data/resume';

const slug = (org: string) => `exp-${org.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
---

<section id="experience" class="section" aria-labelledby="experience-heading">
  <h2 id="experience-heading" class="section-heading mask-reveal"><span class="mask-reveal-inner">Experience</span></h2>

  <ol class="timeline">
    {experience.map((job) => (
      <li id={slug(job.organization)} class="timeline-item" data-animate>
        <div class="timeline-marker" aria-hidden="true"></div>
        <div class="timeline-content">
          <div class="timeline-head">
            <div>
              <h3>{job.role}</h3>
              <p class="timeline-org">{job.organization}</p>
            </div>
            <span class="timeline-period mono-tag">{job.period}</span>
          </div>

          <p class="timeline-summary">{job.summary}</p>

          <ul class="timeline-points">
            {job.points.map((p) => (
              <li>{p}</li>
            ))}
          </ul>

          <ul class="timeline-stack">
            {job.stack.map((tech) => (
              <li>{tech}</li>
            ))}
          </ul>
        </div>
      </li>
    ))}
  </ol>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  // The timeline's left rail fills in accent color as the visitor scrolls
  // through it — a small, honest "progress through the career" cue rather
  // than a decorative flourish. Reduced motion gets the fully-drawn line
  // immediately; nothing here is required to read the content.
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const timeline = document.querySelector<HTMLElement>('.timeline');

  if (timeline) {
    if (reducedMotion) {
      timeline.style.setProperty('--fill', '1');
    } else {
      gsap.to(timeline, {
        '--fill': 1,
        ease: 'none',
        scrollTrigger: {
          trigger: timeline,
          start: 'top 75%',
          end: 'bottom 65%',
          scrub: 0.6,
        },
      });
    }
  }
</script>

<style>
  .timeline {
    margin-top: 2.5rem;
    position: relative;
    padding-left: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 2.75rem;
    --fill: 0;
  }

  .timeline::before,
  .timeline::after {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    width: 1px;
  }

  .timeline::before {
    bottom: 0;
    background: var(--color-border);
  }

  .timeline::after {
    height: calc(var(--fill, 0) * 100%);
    background: var(--color-accent);
    box-shadow: 0 0 6px var(--color-accent-soft);
  }

  .timeline-item {
    position: relative;
  }

  .timeline-marker {
    position: absolute;
    left: -1.94rem;
    top: 0.35rem;
    width: 9px;
    height: 9px;
    border-radius: 999px;
    background: var(--color-ink);
    border: 2px solid var(--color-accent);
  }

  .timeline-head {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .timeline-head h3 {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--color-text);
  }

  .timeline-org {
    font-size: 0.9rem;
    color: var(--color-accent);
  }

  .timeline-period {
    color: var(--color-text-faint);
  }

  .timeline-summary {
    margin-top: 0.85rem;
    max-width: 36rem;
    color: var(--color-text-muted);
    line-height: 1.65;
  }

  .timeline-points {
    margin-top: 0.9rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .timeline-points li {
    position: relative;
    padding-left: 1.1rem;
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--color-text-muted);
  }

  .timeline-points li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 5px;
    height: 1px;
    background: var(--color-text-faint);
  }

  .timeline-stack {
    margin-top: 1.1rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .timeline-stack li {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-text-faint);
    padding: 0.25rem 0.55rem;
    border: 1px solid var(--color-border);
    border-radius: 0.35rem;
  }

  @media (min-width: 40rem) {
    .timeline-head {
      flex-direction: row;
      align-items: baseline;
      justify-content: space-between;
      gap: 1rem;
    }
  }
</style>
