---
import { profile } from '../data/resume';
const year = 2026;
---

<footer class="site-footer">
  <div class="footer-inner">
    <p class="footer-name">{profile.name}</p>
    <p class="footer-copy">&copy; {year} {profile.name}. All rights reserved.</p>
    <a href={`mailto:${profile.email}`} class="footer-email mono-tag">{profile.email}</a>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 4rem;
    /* Bottom padding clears the fixed AI-assistant button's footprint
       (3.75rem circle, 1.25rem from the viewport edge) so the footer's own
       content never sits underneath it once the page is scrolled to the
       very bottom. */
    padding: 2.25rem 1.5rem 5.5rem;
    border-top: 1px solid var(--color-border);
  }

  .footer-inner {
    max-width: 46rem;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .footer-name {
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--color-text);
  }

  .footer-copy {
    font-size: 0.85rem;
    color: var(--color-text-faint);
  }

  .footer-email {
    margin-top: 0.5rem;
    color: var(--color-text-faint);
    transition: color 0.2s ease;
  }

  .footer-email:hover {
    color: var(--color-accent);
  }

  @media (min-width: 40rem) {
    .footer-inner {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      /* Reserves room clear of the fixed assistant button regardless of
         how wide the content column ends up. */
      padding-right: 4.5rem;
    }

    .footer-email {
      margin-top: 0;
    }
  }
</style>
