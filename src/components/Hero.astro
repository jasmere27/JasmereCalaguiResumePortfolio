---
import { profile, experience, projects, skills, certifications } from '../data/resume';

const totalTechnologies = skills.reduce((sum, group) => sum + group.items.length, 0);

const stats = [
  { value: experience.length, label: 'Client Engagements' },
  { value: projects.length, label: 'Personal Projects' },
  { value: totalTechnologies, label: 'Technologies Used' },
  { value: certifications.length, label: 'Certifications' },
];

const nameWords = profile.name.split(' ');
---

<section class="hero" aria-label="Introduction" id="hero">
  <div class="hero-glow" aria-hidden="true"></div>

  <div class="hero-copy">
    <p class="hero-kicker mono-tag">Software Developer · Pampanga, Philippines</p>
    <h1 class="hero-name">
      {nameWords.map((word) => (
        <span class="word-mask"><span class="word-mask-inner">{word}</span></span>
      ))}
    </h1>
    <p class="hero-role">{profile.subtitle}</p>
    <p class="hero-tagline text-balance">{profile.tagline}</p>

    <div class="hero-actions">
      <a href="#projects" class="btn btn-primary" data-cursor>View my work</a>
      <a href="#contact" class="btn btn-ghost" data-cursor>Contact me</a>
    </div>
  </div>

  <dl class="hero-stats">
    {stats.map((s) => (
      <div class="hero-stat">
        <dt class="hero-stat-value" data-count={s.value}>{s.value}</dt>
        <dd class="hero-stat-label">{s.label}</dd>
      </div>
    ))}
  </dl>
</section>

<script>
  import { gsap } from 'gsap';

  const hero = document.getElementById('hero');
  const canHover = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Cinematic entrance. Every hidden starting state below is set by this
  // script and only this script — if it never runs, the hero renders in its
  // normal, fully visible static layout.
  if (!reducedMotion) {
    gsap.set('.word-mask-inner', { yPercent: 112 });
    gsap.set(
      ['.hero-kicker', '.hero-role', '.hero-tagline', '.hero-actions .btn', '.hero-stats'],
      { opacity: 0, y: 16 }
    );

    const tl = gsap.timeline({ delay: 0.2, defaults: { ease: 'power3.out', duration: 0.7 } });
    tl.to('.hero-kicker', { opacity: 1, y: 0 })
      .to(
        '.word-mask-inner',
        { yPercent: 0, duration: 0.9, ease: 'power4.out', stagger: 0.09 },
        '-=0.35'
      )
      .to('.hero-role', { opacity: 1, y: 0 }, '-=0.55')
      .to('.hero-tagline', { opacity: 1, y: 0 }, '-=0.5')
      .to('.hero-actions .btn', { opacity: 1, y: 0, stagger: 0.1 }, '-=0.45')
      .to('.hero-stats', { opacity: 1, y: 0 }, '-=0.5');
  }

  // Cursor-reactive spotlight glow — desktop, fine-pointer only.
  if (hero && canHover && !reducedMotion) {
    let raf = 0;
    hero.addEventListener('pointermove', (e) => {
      if (raf) return;
      raf = requestAnimationFrame(() => {
        const rect = hero.getBoundingClientRect();
        const px = (e.clientX - rect.left) / rect.width;
        const py = (e.clientY - rect.top) / rect.height;
        hero.style.setProperty('--spot-x', `${px * 100}%`);
        hero.style.setProperty('--spot-y', `${py * 100}%`);
        raf = 0;
      });
    });
  }

  // Count-up stats. The DOM already holds the correct final number, so if
  // this never runs (no JS, reduced motion) the real value is always shown.
  if (!reducedMotion) {
    const statEls = document.querySelectorAll<HTMLElement>('.hero-stat-value');
    const animate = (el: HTMLElement) => {
      const target = Number(el.dataset.count);
      if (!Number.isFinite(target)) return;
      const obj = { v: 0 };
      gsap.to(obj, {
        v: target,
        duration: 1.1,
        ease: 'power3.out',
        onUpdate: () => (el.textContent = String(Math.round(obj.v))),
        onComplete: () => (el.textContent = String(target)),
      });
    };
    statEls.forEach(animate);
  }
</script>

<style>
  .hero {
    position: relative;
    padding-top: 3rem;
    padding-bottom: 3.5rem;
    --spot-x: 50%;
    --spot-y: 20%;
  }

  .hero-glow {
    position: absolute;
    inset: -2rem -1.5rem auto -1.5rem;
    height: 26rem;
    background: radial-gradient(
      480px circle at var(--spot-x) var(--spot-y),
      var(--color-accent-soft),
      transparent 65%
    );
    pointer-events: none;
    z-index: 0;
  }

  .hero-copy {
    position: relative;
    z-index: 1;
    max-width: 42rem;
  }

  .hero-kicker {
    color: var(--color-accent);
    margin-bottom: 1.1rem;
  }

  .hero-name {
    display: flex;
    flex-wrap: wrap;
    gap: 0.1em 0.32em;
    font-size: clamp(2.5rem, 1.7rem + 4vw, 4.25rem);
    font-weight: 600;
    line-height: 1.02;
    letter-spacing: -0.02em;
    color: var(--color-text);
  }

  .word-mask {
    display: inline-block;
    overflow: hidden;
    padding-bottom: 0.08em;
  }

  .word-mask-inner {
    display: inline-block;
    will-change: transform;
  }

  .hero-role {
    margin-top: 0.6rem;
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 1rem + 0.6vw, 1.4rem);
    font-weight: 500;
    color: var(--color-text-muted);
  }

  .hero-tagline {
    margin-top: 1.5rem;
    max-width: 34rem;
    font-size: 1.05rem;
    line-height: 1.65;
    color: var(--color-text-muted);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: 2.25rem;
  }

  .hero-stats {
    position: relative;
    z-index: 1;
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem 1rem;
  }

  .hero-stat-value {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 1.4rem + 1vw, 2.1rem);
    font-weight: 600;
    color: var(--color-accent);
    font-variant-numeric: tabular-nums;
  }

  .hero-stat-label {
    margin-top: 0.25rem;
    font-size: 0.82rem;
    color: var(--color-text-faint);
  }

  @media (min-width: 30rem) {
    .hero-stats {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  @media (min-width: 48rem) {
    .hero {
      padding-top: 4.5rem;
      padding-bottom: 4.5rem;
    }

    .hero-tagline {
      max-width: 38rem;
    }

    .hero-stats {
      margin-top: 3.5rem;
    }
  }
</style>
