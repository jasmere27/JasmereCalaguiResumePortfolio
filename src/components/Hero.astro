---
import { profile, experience, projects, skills, certifications } from '../data/resume';
import HeroCrystal from './HeroCrystal.astro';

const totalTechnologies = skills.reduce((sum, group) => sum + group.items.length, 0);

const stats = [
  { value: experience.length, label: 'Client Engagements' },
  { value: projects.length, label: 'Personal Projects' },
  { value: totalTechnologies, label: 'Technologies Used' },
  { value: certifications.length, label: 'Certifications' },
];

const nameWords = profile.name.split(' ');

// Gradient-highlight a real phrase already in the resume data rather than
// writing new marketing copy — "AI-Integrated" is an exact substring of
// profile.subtitle.
const [subtitleBefore, subtitleAfter] = profile.subtitle.split('AI-Integrated');
---

<section class="hero" aria-label="Introduction" id="hero">
  <div class="hero-glow" aria-hidden="true"></div>
  <svg class="hero-wave hero-wave-left" viewBox="0 0 400 500" aria-hidden="true" preserveAspectRatio="none">
    <path d="M-20,60 C 80,120 40,220 140,260 S 60,420 160,470" stroke="url(#wave-violet)" stroke-width="1.5" fill="none" />
    <circle cx="140" cy="260" r="3" fill="var(--color-accent)" />
    <defs>
      <linearGradient id="wave-violet" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="var(--color-accent)" stop-opacity="0.5" />
        <stop offset="100%" stop-color="var(--color-accent)" stop-opacity="0" />
      </linearGradient>
    </defs>
  </svg>
  <svg class="hero-wave hero-wave-right" viewBox="0 0 400 500" aria-hidden="true" preserveAspectRatio="none">
    <path d="M420,80 C 320,140 360,240 260,280 S 340,430 250,480" stroke="url(#wave-teal)" stroke-width="1.5" fill="none" />
    <circle cx="260" cy="280" r="3" fill="var(--color-signal)" />
    <defs>
      <linearGradient id="wave-teal" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="var(--color-signal)" stop-opacity="0.5" />
        <stop offset="100%" stop-color="var(--color-signal)" stop-opacity="0" />
      </linearGradient>
    </defs>
  </svg>

  <div class="hero-inner">
    <div class="hero-copy">
      <p class="hero-kicker mono-tag">Software Developer</p>
      <h1 class="hero-name">
        {nameWords.map((word) => (
          <span class="word-mask"><span class="word-mask-inner">{word}</span></span>
        ))}
      </h1>
      <p class="hero-role">{subtitleBefore}<span class="gradient-text">AI-Integrated</span>{subtitleAfter}</p>
      <p class="hero-tagline text-balance">{profile.tagline}</p>

      <div class="hero-actions">
        <a href="#contact" class="btn btn-primary" data-cursor>Contact me</a>
        <a href="#projects" class="btn btn-ghost" data-cursor>View my projects</a>
      </div>
    </div>

    <div class="hero-visual">
      <div class="hero-showcase">
        <div class="hero-crystal-slot"><HeroCrystal /></div>
        <ul class="float-cards">
          {stats.map((s) => (
            <li class="float-card">
              <span class="float-card-value" data-count={s.value}>{s.value}</span>
              <span class="float-card-label">{s.label}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';

  const hero = document.getElementById('hero');
  const canHover = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Cinematic entrance. Every hidden starting state below is set by this
  // script and only this script — if it never runs, the hero renders in its
  // normal, fully visible static layout. Tuned to fully resolve in ~1.5s
  // (down from ~2.4s) so the primary CTA settles quickly rather than lagging
  // behind the rest of the site's snappier motion language.
  if (!reducedMotion) {
    gsap.set('.word-mask-inner', { yPercent: 112 });
    gsap.set(
      ['.hero-kicker', '.hero-role', '.hero-tagline', '.hero-actions .btn', '.hero-visual', '.float-card'],
      { opacity: 0, y: 14 }
    );

    const tl = gsap.timeline({ delay: 0.15, defaults: { ease: 'power3.out', duration: 0.5 } });
    tl.to('.hero-kicker', { opacity: 1, y: 0 })
      .to(
        '.word-mask-inner',
        { yPercent: 0, duration: 0.65, ease: 'power4.out', stagger: 0.06 },
        '-=0.3'
      )
      .to('.hero-role', { opacity: 1, y: 0 }, '-=0.4')
      .to('.hero-tagline', { opacity: 1, y: 0 }, '-=0.35')
      .to('.hero-actions .btn', { opacity: 1, y: 0, stagger: 0.07 }, '-=0.3')
      .to('.hero-visual', { opacity: 1, y: 0, duration: 0.6 }, '-=0.35')
      .to('.float-card', { opacity: 1, y: 0, stagger: 0.06 }, '-=0.35');
  }

  // Cursor-reactive spotlight glow — desktop, fine-pointer only.
  if (hero && canHover && !reducedMotion) {
    let raf = 0;
    hero.addEventListener('pointermove', (e) => {
      if (raf) return;
      raf = requestAnimationFrame(() => {
        const rect = hero.getBoundingClientRect();
        const px = (e.clientX - rect.left) / rect.width;
        const py = (e.clientY - rect.top) / rect.height;
        hero.style.setProperty('--spot-x', `${px * 100}%`);
        hero.style.setProperty('--spot-y', `${py * 100}%`);
        raf = 0;
      });
    });
  }

  // Count-up stats. The DOM already holds the correct final number, so if
  // this never runs (no JS, reduced motion) the real value is always shown.
  if (!reducedMotion) {
    const statEls = document.querySelectorAll<HTMLElement>('.float-card-value');
    const animate = (el: HTMLElement) => {
      const target = Number(el.dataset.count);
      if (!Number.isFinite(target)) return;
      const obj = { v: 0 };
      gsap.to(obj, {
        v: target,
        duration: 1.1,
        ease: 'power3.out',
        onUpdate: () => (el.textContent = String(Math.round(obj.v))),
        onComplete: () => (el.textContent = String(target)),
      });
    };
    statEls.forEach(animate);
  }
</script>

<style>
  .hero {
    position: relative;
    padding-top: 3rem;
    padding-bottom: 3.5rem;
    --spot-x: 50%;
    --spot-y: 20%;
  }

  .hero-glow {
    position: absolute;
    inset: -2rem -1.5rem auto -1.5rem;
    height: 26rem;
    background: radial-gradient(
      480px circle at var(--spot-x) var(--spot-y),
      var(--color-accent-soft),
      transparent 65%
    );
    pointer-events: none;
    z-index: 0;
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .hero-copy {
    max-width: 42rem;
  }

  .hero-visual {
    display: flex;
    justify-content: center;
  }

  /* Wider than the sidebar's own 64rem breakpoint on purpose: below ~75rem
     the sidebar's fixed 17rem already eats enough width that copy + orbit
     side-by-side would cramp the orbit into a sliver. Stays stacked (and
     roomy) until there's genuinely enough space for both. */
  @media (min-width: 75rem) {
    .hero-inner {
      flex-direction: row;
      align-items: center;
      gap: 3rem;
    }

    .hero-copy {
      max-width: 36rem;
      flex-shrink: 0;
    }

    .hero-visual {
      flex: 1;
      justify-content: center;
    }
  }

  .hero-kicker {
    color: var(--color-accent);
    margin-bottom: 1.1rem;
  }

  .hero-name {
    display: flex;
    flex-wrap: wrap;
    gap: 0.1em 0.32em;
    font-size: clamp(2.75rem, 1.65rem + 4.2vw, 4.75rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.025em;
    color: var(--color-text);
  }

  .word-mask {
    display: inline-block;
    overflow: hidden;
    padding-bottom: 0.08em;
  }

  .word-mask-inner {
    display: inline-block;
    will-change: transform;
  }

  .hero-role {
    margin-top: 0.75rem;
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 1.05rem + 0.7vw, 1.5rem);
    font-weight: 500;
    color: var(--color-text-muted);
  }

  .hero-tagline {
    margin-top: 1.5rem;
    max-width: 32rem;
    font-size: 1.1rem;
    line-height: 1.65;
    color: var(--color-text-muted);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: 2.25rem;
  }

  .gradient-text {
    background: linear-gradient(90deg, var(--color-accent), var(--color-signal));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .hero-wave {
    position: absolute;
    top: 0;
    width: 22rem;
    height: 100%;
    z-index: 0;
    pointer-events: none;
    opacity: 0.7;
    display: none;
  }

  .hero-wave-left {
    left: -6rem;
  }

  .hero-wave-right {
    right: -6rem;
  }

  @media (min-width: 64rem) {
    .hero-wave {
      display: block;
    }
  }

  .hero-showcase {
    position: relative;
    width: 100%;
    max-width: 22rem;
    margin-inline: auto;
  }

  .hero-crystal-slot {
    position: relative;
    z-index: 1;
  }

  .float-cards {
    margin-top: 1.5rem;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem;
  }

  .float-card {
    padding: 0.85rem 1rem;
    background: color-mix(in srgb, var(--color-surface) 70%, transparent);
    backdrop-filter: blur(10px);
    border: 1px solid var(--color-border-strong);
    border-radius: 0.65rem;
    box-shadow: 0 8px 24px -8px rgba(0, 0, 0, 0.5);
  }

  .float-card-value {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 1.2rem + 0.6vw, 1.6rem);
    font-weight: 600;
    color: var(--color-accent);
    font-variant-numeric: tabular-nums;
  }

  .float-card-label {
    margin-top: 0.2rem;
    display: block;
    font-size: 0.72rem;
    color: var(--color-text-faint);
  }

  @media (min-width: 40rem) {
    .hero-showcase {
      max-width: none;
      height: 24rem;
    }

    .hero-crystal-slot {
      position: absolute;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .float-cards {
      position: absolute;
      inset: 0;
      display: block;
      margin-top: 0;
    }

    .float-card {
      position: absolute;
      width: 8.5rem;
    }

    .float-card:nth-child(1) {
      top: 0;
      left: 0;
    }

    .float-card:nth-child(2) {
      top: 1rem;
      right: 0;
    }

    .float-card:nth-child(3) {
      bottom: 1rem;
      left: 0.5rem;
    }

    .float-card:nth-child(4) {
      bottom: 0;
      right: 0.5rem;
    }
  }

  @media (min-width: 48rem) {
    .hero {
      padding-top: 4.5rem;
      padding-bottom: 4.5rem;
    }

    .hero-tagline {
      max-width: 38rem;
    }
  }
</style>
