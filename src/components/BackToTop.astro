---
---

<button type="button" id="back-to-top" class="back-to-top" aria-label="Back to top" data-cursor hidden>
  <svg viewBox="0 0 24 24" aria-hidden="true" class="back-to-top-icon">
    <path d="M12 5l-7 7M12 5l7 7M12 5v14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
</button>

<script>
  import { gsap } from 'gsap';

  const button = document.getElementById('back-to-top') as HTMLButtonElement | null;
  const hero = document.getElementById('hero');
  if (!button || !hero) throw new Error('BackToTop: expected #back-to-top and #hero to exist');

  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  let visible = false;

  const setVisible = (next: boolean) => {
    if (next === visible) return;
    visible = next;
    if (next) button.hidden = false;
    if (reducedMotion) {
      button.style.opacity = next ? '1' : '0';
      if (!next) button.hidden = true;
      return;
    }
    gsap.to(button, {
      opacity: next ? 1 : 0,
      scale: next ? 1 : 0.85,
      duration: 0.25,
      ease: 'power2.out',
      onComplete: () => {
        if (!next) button.hidden = true;
      },
    });
  };

  const io = new IntersectionObserver(
    (entries) => setVisible(!entries[0].isIntersecting),
    { rootMargin: '-10% 0px 0px 0px' }
  );
  io.observe(hero);

  button.addEventListener('click', () => {
    const motion = (window as unknown as { __motion?: { lenis?: { scrollTo: (t: number, o?: object) => void } } }).__motion;
    if (motion?.lenis) {
      motion.lenis.scrollTo(0, { duration: 1.1 });
    } else {
      window.scrollTo({ top: 0, behavior: reducedMotion ? 'auto' : 'smooth' });
    }
    button.blur();
    hero.setAttribute('tabindex', '-1');
    hero.focus({ preventScroll: true });
  });
</script>

<style>
  .back-to-top {
    position: fixed;
    left: 1.25rem;
    bottom: 1.25rem;
    z-index: 80;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    background: var(--color-surface-raised);
    border: 1px solid var(--color-border-strong);
    border-radius: 999px;
    color: var(--color-text-muted);
    opacity: 0;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.35);
    transition: border-color 0.2s ease, color 0.2s ease, transform 0.2s ease;
  }

  .back-to-top:hover,
  .back-to-top:focus-visible {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .back-to-top-icon {
    width: 1.15rem;
    height: 1.15rem;
  }

  @media (min-width: 64rem) {
    .back-to-top {
      left: 18.25rem;
    }
  }
</style>
