---
import { profile } from '../data/resume';

const [emailLocal, emailDomain] = profile.email.split('@');
const phoneHref = profile.phone.replace(/\s+/g, '');

const cards = [
  {
    label: 'Email',
    value: profile.email,
    href: `mailto:${profile.email}`,
    linkText: 'Email',
    copyValue: profile.email,
  },
  {
    label: 'Phone',
    value: profile.phone,
    href: `tel:${phoneHref}`,
    linkText: 'Call',
    copyValue: profile.phone,
  },
  {
    label: 'Location',
    value: profile.location,
    href: null,
    linkText: null,
    copyValue: profile.location,
  },
];
---

<section id="contact" class="section" aria-labelledby="contact-heading">
  <h2 id="contact-heading" class="section-heading">Contact</h2>
  <p class="contact-intro text-balance" data-animate>
    Open to software developer roles and freelance work involving web, mobile, or AI-integrated systems.
    The fastest way to reach me is email.
  </p>

  <div class="contact-grid">
    {cards.map((c) => (
      <div class="contact-card" data-animate>
        <span class="contact-label mono-tag">{c.label}</span>
        <span class="contact-value">
          {c.label === 'Email' ? <>{emailLocal}@<wbr />{emailDomain}</> : c.value}
        </span>
        <div class="contact-card-actions">
          {c.href && (
            <a href={c.href} class="contact-action">{c.linkText}</a>
          )}
          <button type="button" class="contact-action contact-copy" data-copy={c.copyValue}>
            Copy
          </button>
        </div>
      </div>
    ))}
  </div>

  <div class="contact-cta-row" data-animate>
    <a href={`mailto:${profile.email}`} class="btn btn-primary">Say hello</a>
    <a href="/jasmere-paul-calagui-resume.pdf" class="btn btn-ghost" download>Download résumé</a>
  </div>

  <p class="visually-hidden" role="status" aria-live="polite" id="copy-status"></p>
</section>

<script>
  const statusEl = document.getElementById('copy-status');

  document.querySelectorAll<HTMLButtonElement>('.contact-copy').forEach((button) => {
    button.addEventListener('click', async () => {
      const value = button.dataset.copy ?? '';
      try {
        await navigator.clipboard.writeText(value);
        const original = button.textContent;
        button.textContent = 'Copied';
        button.classList.add('copied');
        if (statusEl) statusEl.textContent = `${value} copied to clipboard`;
        window.setTimeout(() => {
          button.textContent = original;
          button.classList.remove('copied');
        }, 1800);
      } catch {
        if (statusEl) statusEl.textContent = 'Could not copy — please copy manually.';
      }
    });
  });
</script>

<style>
  .contact-intro {
    margin-top: 1rem;
    max-width: 34rem;
    color: var(--color-text-muted);
    line-height: 1.65;
  }

  .contact-grid {
    margin-top: 2.25rem;
    display: grid;
    gap: 1rem;
    grid-template-columns: 1fr;
  }

  .contact-card {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 1.25rem 1.4rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 0.65rem;
    transition: border-color 0.2s ease, background-color 0.2s ease;
  }

  .contact-card:hover {
    border-color: var(--color-border-strong);
    background: var(--color-surface-raised);
  }

  .contact-label {
    color: var(--color-text-faint);
  }

  .contact-value {
    font-size: 0.95rem;
    color: var(--color-text);
    overflow-wrap: anywhere;
  }

  .contact-card-actions {
    display: flex;
    gap: 1rem;
    margin-top: 0.5rem;
  }

  .contact-action {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-text-faint);
    transition: color 0.2s ease;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
  }

  .contact-action:hover {
    color: var(--color-accent);
  }

  .contact-copy.copied {
    color: var(--color-signal);
  }

  .contact-cta-row {
    margin-top: 2.25rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (min-width: 34rem) {
    .contact-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 56rem) {
    .contact-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
