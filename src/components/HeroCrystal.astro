---
// A faceted, gem-like centerpiece for the hero — built as flat-shaded SVG
// polygons (a classic "low-poly" technique), not a WebGL/3D-engine scene.
// Keeps the visual weight the redesign calls for without a new heavy
// dependency or GPU cost beyond a single CSS drop-shadow.
const CX = 120;
const TOP_Y = 12;
const GIRDLE_Y = 138;
const BOTTOM_Y = 292;
const RX = 96;
const RY = 40;
const FACETS = 7;

const girdle = Array.from({ length: FACETS }, (_, i) => {
  const angle = (i / FACETS) * Math.PI * 2 - Math.PI / 2;
  return {
    x: Number((CX + RX * Math.cos(angle)).toFixed(1)),
    y: Number((GIRDLE_Y + RY * Math.sin(angle)).toFixed(1)),
  };
});

const crownFacets = girdle.map((p, i) => {
  const next = girdle[(i + 1) % FACETS];
  return { points: `${CX},${TOP_Y} ${p.x},${p.y} ${next.x},${next.y}`, shade: i % 2 };
});

const pavilionFacets = girdle.map((p, i) => {
  const next = girdle[(i + 1) % FACETS];
  return { points: `${CX},${BOTTOM_Y} ${p.x},${p.y} ${next.x},${next.y}`, shade: (i + 1) % 2 };
});
const CENTER_Y = (TOP_Y + BOTTOM_Y) / 2;
---

<div class="hero-crystal" aria-hidden="true" data-cx={CX} data-cy={CENTER_Y}>
  <div class="hero-crystal-burst"></div>
  <svg viewBox="0 0 240 300" fill="none">
    <defs>
      <linearGradient id="facet-light" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="#c4b5fd" />
        <stop offset="100%" stop-color="var(--color-accent)" />
      </linearGradient>
      <linearGradient id="facet-dark" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="var(--color-accent-dim)" />
        <stop offset="100%" stop-color="#3a2266" />
      </linearGradient>
      <linearGradient id="facet-teal" x1="0" y1="1" x2="1" y2="0">
        <stop offset="0%" stop-color="var(--color-accent-dim)" />
        <stop offset="100%" stop-color="var(--color-signal)" />
      </linearGradient>
    </defs>

    <g class="crystal-spin">
      {crownFacets.map((f, i) => (
        <polygon
          points={f.points}
          fill={i === 0 ? 'url(#facet-teal)' : f.shade ? 'url(#facet-dark)' : 'url(#facet-light)'}
          stroke="var(--color-ink)"
          stroke-width="1.5"
        />
      ))}
      {pavilionFacets.map((f) => (
        <polygon
          points={f.points}
          fill={f.shade ? 'url(#facet-dark)' : 'url(#facet-light)'}
          stroke="var(--color-ink)"
          stroke-width="1.5"
          opacity="0.92"
        />
      ))}
    </g>
  </svg>
</div>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  // Prefer the site-wide motion/reduced-motion state MotionRoot already
  // derived (it runs earlier in document order, in BaseLayout, ahead of
  // any section content) — fall back to a direct check only if that
  // singleton somehow isn't there yet.
  const motion = (window as unknown as { __motion?: { reducedMotion: boolean } }).__motion;
  const reducedMotion = motion?.reducedMotion ?? window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const root = document.querySelector<HTMLElement>('.hero-crystal');
  const spin = document.querySelector<SVGGElement>('.crystal-spin');
  const burst = document.querySelector<HTMLElement>('.hero-crystal-burst');

  // A gentle sway + bob rather than a full spin — a real gem's facets
  // aren't rotationally symmetric, so a continuous 360deg turn would flash
  // oddly each time an asymmetric face swept past. This reads as "suspended
  // and slowly turning" without ever looking broken.
  if (spin && !reducedMotion) {
    const tl = gsap.timeline({ repeat: -1, yoyo: true, defaults: { ease: 'sine.inOut', duration: 5 } });
    tl.to(spin, { rotateY: 18, rotateZ: 3, y: -8 }, 0);
    gsap.set(spin, { transformOrigin: '120px 150px' });
  }

  // Shatter on scroll: each facet flies outward along the line from the
  // crystal's own center through that facet's center — a real explosion
  // radiates from a point, so this reads as physically coherent rather than
  // arbitrary jitter, without pulling in a physics engine for it.
  //
  // Trigger is the crystal's own element, not the whole hero section: the
  // crystal sits above the section's vertical middle, so it scrolls out of
  // the viewport's top edge well before the hero's bottom does. Tying the
  // range to `#hero` measured the shatter against the wrong distance — most
  // of it played out after the crystal was already off-screen. Using the
  // crystal itself as the trigger means "top top" -> "bottom top" covers
  // exactly the distance during which it's passing through the top of the
  // viewport, so the break-apart is fully visible while it happens, and
  // reverses for free if the visitor scrolls back up.
  if (root && spin && !reducedMotion) {
    const cx = Number(root.dataset.cx);
    const cy = Number(root.dataset.cy);
    const facets = Array.from(spin.querySelectorAll<SVGPolygonElement>('polygon'));

    const vectors = facets.map((facet) => {
      const box = facet.getBBox();
      const fx = box.x + box.width / 2;
      const fy = box.y + box.height / 2;
      const dx = fx - cx;
      const dy = fy - cy;
      const dist = Math.hypot(dx, dy) || 1;
      const angleDeg = Math.atan2(dy, dx) * (180 / Math.PI);
      // Crown facets (near the top point) are smaller and lighter-looking —
      // sending them a bit further than the broader pavilion facets keeps
      // the burst from reading as one flat ring expanding outward.
      const throwDistance = fy < cy ? 130 : 95;
      return {
        x: (dx / dist) * throwDistance,
        y: (dy / dist) * throwDistance,
        rotate: angleDeg * 0.5,
      };
    });

    gsap.set(facets, { transformOrigin: '50% 50%' });

    // A fixed distance rather than "bottom top": the crystal's own rendered
    // height (~240-300px) would make the whole break-apart resolve within a
    // single quick scroll gesture. Stretching it over more scroll distance
    // makes it something a visitor actually sees happen, not a flicker.
    const scrollTriggerConfig = { trigger: root, start: 'top top', end: '+=450', scrub: 0.4 };

    gsap.to(facets, {
      x: (i) => vectors[i].x,
      y: (i) => vectors[i].y,
      rotate: (i) => vectors[i].rotate,
      opacity: 0.08,
      stagger: 0.025,
      ease: 'power1.in',
      scrollTrigger: scrollTriggerConfig,
    });

    if (burst) {
      gsap
        .timeline({ scrollTrigger: scrollTriggerConfig })
        .to(burst, { opacity: 0.85, scale: 1.35, duration: 0.5, ease: 'power1.out' })
        .to(burst, { opacity: 0, scale: 1.7, duration: 0.5, ease: 'power1.in' });
    }
  }
</script>

<style>
  .hero-crystal {
    position: relative;
    width: 100%;
    max-width: 15rem;
    margin-inline: auto;
    filter: drop-shadow(0 0 48px var(--color-accent-soft)) drop-shadow(0 18px 32px rgba(0, 0, 0, 0.35));
  }

  .hero-crystal svg {
    position: relative;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .crystal-spin {
    transform-box: fill-box;
  }

  /* Starts fully transparent — only the shatter scroll-tween (gated behind
     prefers-reduced-motion in the script) ever raises its opacity above 0,
     so a visitor who never triggers that path never sees a stray glow. */
  .hero-crystal-burst {
    position: absolute;
    inset: 15% 10%;
    z-index: -1;
    opacity: 0;
    border-radius: 999px;
    background: radial-gradient(circle, var(--color-accent-soft), var(--color-signal-soft) 55%, transparent 75%);
    pointer-events: none;
  }
</style>
